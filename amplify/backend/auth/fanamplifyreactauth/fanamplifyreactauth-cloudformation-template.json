{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "{\"createdOn\":\"Linux\",\"createdBy\":\"Amplify\",\"createdWith\":\"12.0.0\",\"stackType\":\"auth-Cognito\",\"metadata\":{}}",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "authRoleArn": {
      "Type": "String"
    },
    "unauthRoleArn": {
      "Type": "String"
    },
    "identityPoolName": {
      "Type": "String",
      "Default": "fanamplifyreactauth_identitypool"
    },
    "allowUnauthenticatedIdentities": {
      "Type": "String",
      "Default": "false"
    },
    "resourceNameTruncated": {
      "Type": "String",
      "Default": "fanamp"
    },
    "userPoolName": {
      "Type": "String",
      "Default": "fanamplifyreactauth_userpool"
    },
    "autoVerifiedAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "mfaConfiguration": {
      "Type": "String",
      "Default": "OFF"
    },
    "mfaTypes": {
      "Type": "CommaDelimitedList",
      "Default": "SMS Text Message"
    },
    "smsAuthenticationMessage": {
      "Type": "String",
      "Default": "Your authentication code is {####}"
    },
    "smsVerificationMessage": {
      "Type": "String",
      "Default": "Your verification code is {####}"
    },
    "emailVerificationSubject": {
      "Type": "String",
      "Default": "Your verification code"
    },
    "emailVerificationMessage": {
      "Type": "String",
      "Default": "Your verification code is {####}"
    },
    "defaultPasswordPolicy": {
      "Type": "String",
      "Default": "false"
    },
    "passwordPolicyMinLength": {
      "Type": "Number",
      "Default": 8
    },
    "passwordPolicyCharacters": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "requiredAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "aliasAttributes": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "userpoolClientGenerateSecret": {
      "Type": "String",
      "Default": "false"
    },
    "userpoolClientRefreshTokenValidity": {
      "Type": "Number",
      "Default": 30
    },
    "userpoolClientWriteAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "userpoolClientReadAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "userpoolClientLambdaRole": {
      "Type": "String",
      "Default": "fanamp_userpoolclient_lambda_role"
    },
    "userpoolClientSetAttributes": {
      "Type": "String",
      "Default": "false"
    },
    "sharedId": {
      "Type": "String",
      "Default": "fanamplifyreactauth"
    },
    "resourceName": {
      "Type": "String",
      "Default": "fanamplifyreactauth"
    },
    "authSelections": {
      "Type": "String",
      "Default": "identityPoolAndUserPool"
    },
    "useDefault": {
      "Type": "String",
      "Default": "default"
    },
    "userPoolGroupList": {
      "Type": "CommaDelimitedList",
      "Default": ""
    },
    "serviceName": {
      "Type": "String",
      "Default": "Cognito"
    },
    "usernameCaseSensitive": {
      "Type": "String",
      "Default": "false"
    },
    "useEnabledMfas": {
      "Type": "String",
      "Default": "true"
    },
    "dependsOn": {
      "Type": "CommaDelimitedList",
      "Default": ""
    }
  },
  "Conditions": {
    "ShouldNotCreateEnvResources": {
      "Fn::Equals": [
        {
          "Ref": "env"
        },
        "NONE"
      ]
    }
  },
  "Resources": {
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            {
              "Ref": "userPoolName"
            },
            {
              "Fn::Join": [
                "",
                [
                  {
                    "Ref": "userPoolName"
                  },
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "Schema": [
          {
            "Name": "email",
            "Required": true,
            "Mutable": true
          }
        ],
        "AutoVerifiedAttributes": {
          "Ref": "autoVerifiedAttributes"
        },
        "EmailVerificationMessage": {
          "Ref": "emailVerificationMessage"
        },
        "EmailVerificationSubject": {
          "Ref": "emailVerificationSubject"
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": {
              "Ref": "passwordPolicyMinLength"
            },
            "RequireLowercase": false,
            "RequireNumbers": false,
            "RequireSymbols": false,
            "RequireUppercase": false
          }
        },
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "MfaConfiguration": {
          "Ref": "mfaConfiguration"
        }
      }
    },
    "UserPoolClientWeb": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "resourceNameTruncated"
              },
              "_app_clientWeb"
            ]
          ]
        },
        "RefreshTokenValidity": {
          "Ref": "userpoolClientRefreshTokenValidity"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        }
      },
      "DependsOn": [
        "UserPool"
      ]
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "resourceNameTruncated"
              },
              "_app_client"
            ]
          ]
        },
        "GenerateSecret": {
          "Ref": "userpoolClientGenerateSecret"
        },
        "RefreshTokenValidity": {
          "Ref": "userpoolClientRefreshTokenValidity"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        }
      },
      "DependsOn": [
        "UserPool"
      ]
    },
    "UserPoolClientRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            {
              "Ref": "userpoolClientLambdaRole"
            },
            {
              "Fn::Join": [
                "",
                [
                  {
                    "Ref": "userpoolClientLambdaRole"
                  },
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "UserPoolClientLambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "ZipFile": "const response = require('cfn-response');\nconst aws = require('aws-sdk');\nconst identity = new aws.CognitoIdentityServiceProvider();\nexports.handler = (event, context, callback) => {\n  if (event.RequestType == 'Delete') {\n    response.send(event, context, response.SUCCESS, {});\n  }\n  if (event.RequestType == 'Update' || event.RequestType == 'Create') {\n    const params = {\n      ClientId: event.ResourceProperties.clientId,\n      UserPoolId: event.ResourceProperties.userpoolId\n    };\n    identity.describeUserPoolClient(params).promise()\n      .then((res) => {\n        response.send(event, context, response.SUCCESS, {'appSecret': res.UserPoolClient.ClientSecret});\n      })\n      .catch((err) => {\n        response.send(event, context, response.FAILED, {err});\n      });\n  }\n};"
        },
        "Handler": "index.handler",
        "Runtime": "nodejs18.x",
        "Timeout": 300,
        "Role": {
          "Fn::GetAtt": [
            "UserPoolClientRole",
            "Arn"
          ]
        }
      },
      "DependsOn": [
        "UserPoolClientRole"
      ]
    },
    "UserPoolClientLambdaPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "userpoolClientLambdaRole"
              },
              "-lambda-policy"
            ]
          ]
        },
        "Roles": [
          {
            "Ref": "UserPoolClientRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "cognito-idp:DescribeUserPoolClient"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "UserPool",
                  "Arn"
                ]
              }
            }
          ]
        }
      },
      "DependsOn": [
        "UserPoolClientLambda"
      ]
    },
    "UserPoolClientLogPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "userpoolClientLambdaRole"
              },
              "-lambda-log-policy"
            ]
          ]
        },
        "Roles": [
          {
            "Ref": "UserPoolClientRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:logs:${region}:${account}:log-group:/aws/lambda/${lambda}:log-stream:*",
                  {
                    "region": {
                      "Ref": "AWS::Region"
                    },
                    "account": {
                      "Ref": "AWS::AccountId"
                    },
                    "lambda": {
                      "Ref": "UserPoolClientLambda"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "DependsOn": [
        "UserPoolClientLambdaPolicy"
      ]
    },
    "UserPoolClientInputs": {
      "Type": "Custom::LambdaCallout",
      "Properties": {
        "ServiceToken": {
          "Fn::GetAtt": [
            "UserPoolClientLambda",
            "Arn"
          ]
        },
        "clientId": {
          "Ref": "UserPoolClient"
        },
        "userpoolId": {
          "Ref": "UserPool"
        }
      },
      "DependsOn": [
        "UserPoolClientLogPolicy"
      ]
    },
    "IdentityPool": {
      "Type": "AWS::Cognito::IdentityPool",
      "Properties": {
        "IdentityPoolName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            {
              "Ref": "identityPoolName"
            },
            {
              "Fn::Join": [
                "",
                [
                  {
                    "Ref": "identityPoolName"
                  },
                  "__",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "AllowUnauthenticatedIdentities": {
          "Ref": "allowUnauthenticatedIdentities"
        },
        "CognitoIdentityProviders": [
          {
            "ClientId": {
              "Ref": "UserPoolClient"
            },
            "ProviderName": {
              "Fn::Sub": [
                "cognito-idp.${region}.amazonaws.com/${client}",
                {
                  "region": {
                    "Ref": "AWS::Region"
                  },
                  "client": {
                    "Ref": "UserPool"
                  }
                }
              ]
            }
          },
          {
            "ClientId": {
              "Ref": "UserPoolClientWeb"
            },
            "ProviderName": {
              "Fn::Sub": [
                "cognito-idp.${region}.amazonaws.com/${client}",
                {
                  "region": {
                    "Ref": "AWS::Region"
                  },
                  "client": {
                    "Ref": "UserPool"
                  }
                }
              ]
            }
          }
        ]
      },
      "DependsOn": [
        "UserPoolClientInputs"
      ]
    },
    "IdentityPoolRoleMap": {
      "Type": "AWS::Cognito::IdentityPoolRoleAttachment",
      "Properties": {
        "IdentityPoolId": {
          "Ref": "IdentityPool"
        },
        "Roles": {
          "unauthenticated": {
            "Ref": "unauthRoleArn"
          },
          "authenticated": {
            "Ref": "authRoleArn"
          }
        }
      },
      "DependsOn": [
        "IdentityPool"
      ]
    }
  },
  "Outputs": {
    "IdentityPoolId": {
      "Value": {
        "Ref": "IdentityPool"
      },
      "Description": "Id for the identity pool"
    },
    "IdentityPoolName": {
      "Value": {
        "Fn::GetAtt": [
          "IdentityPool",
          "Name"
        ]
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "UserPool"
      },
      "Description": "Id for the user pool"
    },
    "UserPoolArn": {
      "Value": {
        "Fn::GetAtt": [
          "UserPool",
          "Arn"
        ]
      },
      "Description": "Arn for the user pool"
    },
    "UserPoolName": {
      "Value": {
        "Ref": "userPoolName"
      }
    },
    "AppClientIDWeb": {
      "Value": {
        "Ref": "UserPoolClientWeb"
      },
      "Description": "The user pool app client id for web"
    },
    "AppClientID": {
      "Value": {
        "Ref": "UserPoolClient"
      },
      "Description": "The user pool app client id"
    },
    "AppClientSecret": {
      "Value": {
        "Fn::GetAtt": [
          "UserPoolClientInputs",
          "appSecret"
        ]
      },
      "Condition": "ShouldNotCreateEnvResources"
    }
  }
}
