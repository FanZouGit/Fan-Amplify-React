# AWS Amplify Configuration
# This file shows example environment variables.
# After running 'amplify push', aws-exports.js will be auto-generated with actual values.

# These values are automatically configured by Amplify CLI
# You typically don't need to set these manually

# AWS_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# API_GATEWAY_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
# S3_BUCKET_NAME=fanamplifyreact-uploads-dev
